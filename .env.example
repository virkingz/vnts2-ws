# docker-compose.yaml 的可选配置项。
# 复制为 .env 后按需修改；未设置时使用 compose 文件中的默认值。
#
# 用法：
#   cp .env.example .env
#   # 编辑 .env 后
#   docker compose -f docker-compose.yaml up -d

# ===== 必改：互联共享令牌 =====
# 所有参与互联的节点必须使用完全相同的非空值。
# 请改成一段足够长的随机字符串，例如：openssl rand -hex 32
SERVER_TOKEN=vnts2-shared-token-change-me

# ===== 网络编号白名单 =====
# 只有此处列出的编号允许客户端注册；留空表示允许任意编号。
# 只限制客户端 -n/--network-code，不影响服务端互联。
NETWORKS=office,lab

# ===== 宿主机端口映射 =====
# 两个节点暴露给客户端连接的 WSS 端口，避免冲突。
PORT_A=8787
PORT_B=8788

# ===== 可选 =====
# 离线租约秒数，超过该时长仍离线的设备会被清理
LEASE_DURATION=86400
# 维护周期（秒）
MAINTENANCE_INTERVAL=15
# 是否禁止服务端中转：1/true/yes/on 为禁止，其余启用
DISABLE_RELAY=0
# 日志级别：debug / info / off
LOG_LEVEL=off
# 日志页密码，留空则 /log 不开放且不记录日志
LOG_PASSWORD=
# /test 状态页密码，留空则公开
TEST_PASSWORD=
