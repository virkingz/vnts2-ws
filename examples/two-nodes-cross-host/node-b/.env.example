# 节点 B 的配置。复制为 .env 后修改。
#   cp .env.example .env
#
# 启动：docker compose up -d
# 查看：docker compose logs -f

# ===== 必填 =====

# 对端地址，格式 http://<对端IP或域名>:<对端互联端口>
# 端口填【对端的 PEER_PORT】（各节点独立部署时默认都是 18786）。
# 切忌填本机地址，否则形成互联环路。
# ⚠️ 留空时 compose 会直接报错并提示，这是有意设计，避免带无效地址启动。
#
# ---- 单个对端 ----
# PEER_HOST=http://203.0.113.10:18786
#
# ---- 多个对端（英文逗号分隔，不要用分号/换行）----
# PEER_HOST=http://203.0.113.10:18786,http://203.0.113.30:18786
#
# 解析规则：按英文逗号切分，自动去除两端空格与末尾斜杠，空项自动忽略。
#
# 拓扑建议：星型（推荐）或全网状，详见 node-a/.env.example 的说明。
# 注意：所有互联节点必须使用【完全相同】的 SERVER_TOKEN。
PEER_HOST=

# 互联共享令牌。必须与节点 A 完全一致，否则互联鉴权失败。
# 生成：openssl rand -hex 32
# 切勿使用示例值。留空时 compose 会报错。
SERVER_TOKEN=


# ===== 常用 =====

# 网络编号白名单，逗号分隔；留空表示允许任意编号。
# 与节点 A 保持一致。
NETWORKS=office,lab

# 客户端接入端口（宿主机）。
# 两台机器各自独立部署，端口互不影响，与 node-a 保持一致即可。
# 仅当两个节点放在同一台机器上联调时，才需要改成 8788。
WSS_PORT=8787

# 互联端口（宿主机）-> 容器内 8786，供对端节点访问。
# 独立部署时与 node-a 一致为 18786。
PEER_PORT=18786

# 互联端口的监听地址（宿主机网卡）。
# 0.0.0.0 = 所有网卡。若两台机器在同一内网，建议设为内网网卡地址，
# 例如 10.0.0.6，使互联流量不经过公网。
PEER_BIND_IP=0.0.0.0


# ===== 可选 =====

LEASE_DURATION=86400
MAINTENANCE_INTERVAL=15
DISABLE_RELAY=0
LOG_LEVEL=off
LOG_PASSWORD=
TEST_PASSWORD=
