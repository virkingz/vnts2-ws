# 节点 A 的配置。复制为 .env 后修改。
#   cp .env.example .env
#
# 启动：docker compose up -d
# 查看：docker compose logs -f

# ===== 必填 =====

# 对端地址，格式 http://<对端IP或域名>:<对端互联端口>
# 端口填【对端的 PEER_PORT】（各节点独立部署时默认都是 18786）。
# 切忌填本机地址，否则形成互联环路。
# ⚠️ 留空时 compose 会直接报错并提示，这是有意设计，避免带无效地址启动。
#
# ---- 单个对端 ----
# PEER_HOST=http://203.0.113.20:18786
#
# ---- 多个对端（英文逗号分隔，不要用分号/换行）----
# PEER_HOST=http://203.0.113.20:18786,http://203.0.113.30:18786,http://node-c.example.com:18786
#
# 解析规则：按英文逗号切分，自动去除每项两端空格与末尾斜杠，空项自动忽略。
# 所以下面这种写法也是有效的：
#   PEER_HOST=http://203.0.113.20:18786, http://203.0.113.30:18786/
#
# 拓扑建议：
#   星型（推荐）—— 中心节点填写所有边缘节点，边缘节点只填中心节点。
#                 互联链路数最少，避免环路，便于排查。
#   全网状     —— 每个节点填写其余全部节点（N 个节点各填 N-1 项）。
#                 冗余度高，但链路与流量成倍增加，节点多时不建议。
#
# 注意：所有互联节点必须使用【完全相同】的 SERVER_TOKEN。
PEER_HOST=

# 互联共享令牌。两端节点必须【完全一致】，否则互联鉴权失败。
# 生成：openssl rand -hex 32
# 切勿使用示例值。留空时 compose 会报错。
SERVER_TOKEN=


# ===== 常用 =====

# 网络编号白名单，逗号分隔；留空表示允许任意编号。
# 两端保持一致，避免同一网络只存在于一端。
NETWORKS=office,lab

# 客户端接入端口（宿主机）。
WSS_PORT=8787

# 互联端口（宿主机）-> 容器内 8786，供对端节点访问。
PEER_PORT=18786

# 互联端口的监听地址（宿主机网卡）。
# 0.0.0.0 = 所有网卡。若两台机器在同一内网，建议设为内网网卡地址，
# 例如 10.0.0.5，使互联流量不经过公网。
PEER_BIND_IP=0.0.0.0


# ===== 可选 =====

# 离线租约秒数，超过该时长仍离线的设备会被清理
LEASE_DURATION=86400

# 维护周期（秒）：清理租约、刷新互联列表、向本地客户端发 Ping
MAINTENANCE_INTERVAL=15

# 是否禁止服务端中转：1/true/yes/on 为禁止，其余启用
DISABLE_RELAY=0

# 日志级别：debug / info / off
LOG_LEVEL=off

# 日志页密码，留空则 /log 不开放且不记录日志
LOG_PASSWORD=

# /test 状态页密码，留空则公开
TEST_PASSWORD=
